# This project runs on Convex (see convex/). Copy to .env.local and fill in real values.

# --- Convex ---
# WebSocket URL the browser client connects to.
VITE_CONVEX_URL=https://your-project.convex.cloud
# Deployment site URL - where Better Auth's HTTP surface lives (the CONVEX_SITE_URL).
VITE_CONVEX_SITE_URL=https://your-project.convex.site

# --- Better Auth ---
# Minted from `npx convex env set BETTER_AUTH_SECRET <random>`; used by the auth
# component to sign sessions and reset tokens.
BETTER_AUTH_SECRET=
# Origin the app is served from (the frontend host), so the auth cookie and Cors
# handling accept it. Must match what browsers actually load.
SITE_URL=http://localhost:5173
# The deployment's site URL - where Better Auth's HTTP surface and the SSO
# callback live. This is the CONVEX_SITE_URL, not the frontend host.
CONVEX_SITE_URL=http://127.0.0.1:3211
# Optional: comma-separated trusted proxy CIDRs if deployed behind a proxy
# (only the rightmost non-proxy hop is recorded in the audit trail).
TRUSTED_PROXIES=
# Optional auth tuning (defaults shown; see convex/auth.ts):
# SESSION_MAX_HOURS=12
# SIGN_IN_RATE_WINDOW_SECONDS=60
# SIGN_IN_RATE_MAX=10
# RESET_TOKEN_MINUTES=60

# --- One-shot bootstrap ---
# The only privileged path with no signed-in user behind it. MUST be removed
# after first go-live. See convex/bootstrap.ts.
BOOTSTRAP_SECRET=

# --- Integrations (unset = feature disabled) ---
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Legal Unit <legal@hyprep.gov.ng>"
# RESEND_API_KEY=
# GOOGLE_CLOUD_VISION_KEY=
# SMTP_HOST=smtp.example.gov.ng
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- SMS (hearing reminders, TOR section 10) ---
# SMS_PROVIDER=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=HYPREP

# --- SSO / OIDC (single sign-on, TOR section 19) ---
# Wired via Better Auth's generic-oauth plugin. Point it at any OIDC provider
# that publishes a discovery document (Microsoft Entra ID, Google Workspace,
# Keycloak, Auth0, Okta). Also flip `ssoEnabled` on in Admin -> System.
# SSO_OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_ISSUER=
# The callback the IdP must be configured to allow:
#   <CONVEX_SITE_URL>/api/auth/callback/oidc
