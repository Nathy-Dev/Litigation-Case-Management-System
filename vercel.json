{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_CONVEX_URL=https://coordinated-grouse-202.eu-west-1.convex.cloud VITE_CONVEX_SITE_URL=https://coordinated-grouse-202.eu-west-1.convex.site npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
